{
    "name":  "vetralink-pro",
    "version":  "1.0.0",
    "private":  true,
    "description":  "VETRALINK PRO â€” Enterprise Farm SaaS ERP, LMS \u0026 Tele-Veterinary Platform",
    "workspaces":  [
                       "apps/*",
                       "packages/*"
                   ],
    "scripts":  {
                    "build":  "turbo run build",
                    "dev":  "turbo run dev",
                    "lint":  "turbo run lint",
                    "test":  "turbo run test",
                    "clean":  "turbo run clean \u0026\u0026 rm -rf node_modules",
                    "db:generate":  "turbo run db:generate",
