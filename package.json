{
    "name":  "vetralink-pro",
    "version":  "1.0.0",
    "private":  true,
    "description":  "VETRALINK PRO â€” Enterprise Farm SaaS ERP, LMS \u0026 Tele-Veterinary Platform",
    "workspaces":  [
                       "apps/*",
                       "packages/*"
                   ],
    "scripts":  {
                    "build":  "turbo run build",
                    "dev":  "turbo run dev",
                    "lint":  "turbo run lint",
                    "test":  "turbo run test",
                    "clean":  "turbo run clean \u0026\u0026 rm -rf node_modules",
                    "db:generate":  "turbo run db:generate",
                    "db:migrate":  "turbo run db:migrate",
                    "format":  "prettier --write \"**/*.{ts,tsx,md,json}\""
                },
    "devDependencies":  {
                            "prettier":  "^3.3.3",
                            "turbo":  "^2.1.1",
                            "typescript":  "^5.5.4"
                        },
    "packageManager":  "pnpm@10.18.3",
    "engines":  {
                    "node":  "\u003e=20.0.0",
                    "pnpm":  "\u003e=9.0.0"
                },
    "pnpm":  {
                 "overrides": {
                     "@nestjs/platform-express@10>express": "4.22.3",
                     "@nestjs/platform-express@10>body-parser": "1.20.6",
                     "@nestjs/platform-express@10>multer": "2.4.0",
                     "proxy-addr@>=2.0.0 <2.0.8": "2.0.8",
                     "qs@>=6.0.0 <6.16.0": "6.16.0",
                     "lodash@>=4.0.0 <4.18.1": "4.18.1",
                     "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
                     "postcss@>=8.0.0 <8.5.31": "8.5.31",
                     "source-map-js@>=1.0.0 <1.2.2": "1.2.2"
                 },
                 "onlyBuiltDependencies":  [
                                               "@nestjs/core",
                                               "@prisma/client",
                                               "@prisma/engines",
                                               "esbuild",
                                               "prisma"
                                           ]
             }
}