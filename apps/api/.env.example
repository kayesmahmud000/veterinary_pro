# -----------------------------------------------------------------------------
# VETRALINK PRO — API Gateway Environment Configuration Example
# Copy this template to .env and provide your secret values
# -----------------------------------------------------------------------------

# Application Runtime
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000

# Primary PostgreSQL Database & Connection Pooling
DATABASE_URL=postgresql://vetralink:vetralink_secret_dev_pass@localhost:5432/vetralink_dev?schema=public
# DATABASE_REPLICA_URL=
SLOW_QUERY_THRESHOLD_MS=200
DB_CONNECT_RETRY_DELAY_MS=1000

# Distributed Cache & BullMQ Queue (Redis 7)
REDIS_URL=redis://:redis_secret_dev_pass@localhost:6379

# Cryptography & Token Security (Access: 15m, Refresh: 7d)
JWT_ACCESS_SECRET=dev_jwt_access_secret_minimum_32_characters_long
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_minimum_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Data At Rest & PII Encryption (AES-256-GCM 32-byte hex & HMAC Pepper)
AES_PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HASH_PEPPER=dev_phone_hash_pepper_key_16

# AWS / Cloudflare R2 Object Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_MEDIA=vetralink-media-dev
S3_BUCKET_DELIVERIES=vetralink-deliveries-dev

# Payment Gateways (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Tele-Veterinary WebRTC (Daily.co)
DAILY_API_KEY=
