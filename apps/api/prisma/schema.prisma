  status               PrescriptionStatus @default(DRAFT)
  diagnosis            String             @db.Text
  notes                String?            @db.Text
  medications          Json               // [{ name, formulation, dosage, frequency, durationDays, route, withdrawalDaysMilk, withdrawalDaysMeat, instructions }]
