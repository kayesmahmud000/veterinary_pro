model Consultation {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmerId       String             @map("farmer_id") @db.Uuid
  vetId          String?            @map("vet_id") @db.Uuid
  farmId         String             @map("farm_id") @db.Uuid
  animalId       String?            @map("animal_id") @db.Uuid
  chiefComplaint String             @map("chief_complaint") @db.Text
  mediaUrls      Json               @default("[]") @map("media_urls")
  type           ConsultationType   @default(ASYNC_TICKET)
  status         ConsultationStatus @default(SUBMITTED)
  roomSessionId      String?                   @map("room_session_id") @db.VarChar(255)
  feeCents           Int                       @default(0) @map("fee_cents")
  scheduledAt        DateTime?                 @map("scheduled_at") @db.Timestamptz(6)
  assignedAt         DateTime?                 @map("assigned_at") @db.Timestamptz(6)
  paymentStatus      ConsultationPaymentStatus @default(UNPAID) @map("payment_status")
  paymentIntentId    String?                   @map("payment_intent_id") @db.VarChar(255)
  paymentHeldAt      DateTime?                 @map("payment_held_at") @db.Timestamptz(6)
  paymentCapturedAt  DateTime?                 @map("payment_captured_at") @db.Timestamptz(6)
  paymentReleasedAt  DateTime?                 @map("payment_released_at") @db.Timestamptz(6)
  currency           String                    @default("USD") @db.VarChar(10)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  farmer       User          @relation("FarmerConsultation", fields: [farmerId], references: [id], onDelete: Restrict)
  vet          User?         @relation("VetConsultation", fields: [vetId], references: [id], onDelete: SetNull)
  farm         Farm          @relation(fields: [farmId], references: [id], onDelete: Restrict)
  animal       Animal?       @relation(fields: [animalId], references: [id], onDelete: SetNull)
  prescription Prescription?
  payoutLedger ConsultationPayoutLedger?
  review       ConsultationReview?
  notificationLogs ConsultationNotificationLog[]
  messages     ConsultationMessage[]
  clinicalNotes ConsultationClinicalNote[]

  @@index([farmerId, status])
  @@index([vetId, status])
  @@index([farmId])
  @@index([vetId, scheduledAt])
  @@index([paymentStatus])
  @@index([paymentIntentId])
  @@map("consultations")
}

model ConsultationMessage {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consultationId String                  @map("consultation_id") @db.Uuid
