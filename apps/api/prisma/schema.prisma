model Product {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title               String           @db.VarChar(255)
  slug                String           @unique @db.VarChar(200)
  type                ProductType
  description         String           @db.Text
  priceCents          Int              @map("price_cents")
  discountPriceCents  Int?             @map("discount_price_cents")
  currency            String           @default("USD") @db.VarChar(3)
  contentS3Key        String           @map("content_s3_key") @db.Text
  minSubscriptionTier SubscriptionTier @default(STARTER) @map("min_subscription_tier")
  isPublished         Boolean          @default(false) @map("is_published")
  metadata            Json             @default("{}")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?        @map("deleted_at") @db.Timestamptz(6)

  orderItems OrderItem[]

  @@index([type, isPublished])
  @@index([isPublished, type, createdAt(sort: Desc)])
  @@map("products")
}

model Order {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  totalCents     Int         @map("total_cents")
  currency       String      @default("USD") @db.VarChar(3)
  status         OrderStatus @default(PENDING)
  paymentGateway String      @map("payment_gateway") @db.VarChar(50)
  gatewayTxId    String?     @unique @map("gateway_tx_id") @db.VarChar(255)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@index([userId, status])
  @@map("orders")
}

model OrderItem {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String    @map("order_id") @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  priceCents       Int       @map("price_cents")
  downloadToken    String    @default(dbgenerated("gen_random_uuid()")) @map("download_token") @db.Uuid
  downloadCount    Int       @default(0) @map("download_count")
  lastDownloadedAt DateTime? @map("last_downloaded_at") @db.Timestamptz(6)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([downloadToken])
  @@map("order_items")
}

