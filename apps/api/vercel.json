{
  "version": 2,
  "buildCommand": "pnpm --filter @vetralink/shared-types build && pnpm --filter @vetralink/api build",
  "functions": {
    "api/index.js": {
      "includeFiles": "{dist/**,prisma/**,node_modules/.prisma/client/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
