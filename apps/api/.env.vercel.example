# ==============================================================================
# VETRALINK PRO — Vercel Environment Variables Template
# Copy these key-value pairs into: Vercel Project Settings -> Environment Variables
# ==============================================================================

# Runtime Configuration
# Vercel skips optional integration validation unless STRICT_PROD_INTEGRATIONS is enabled.
NODE_ENV=production
PORT=3001
CORS_ORIGINS=https://veterinary-pro-web.vercel.app

# Cloud PostgreSQL Database (Recommended: Neon.tech Serverless Postgres)
# IMPORTANT: Use the pooled connection string (with ?sslmode=require&pgbouncer=true)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/vetralink?sslmode=require&pgbouncer=true

# Cloud Redis (Recommended: Upstash.com Serverless Redis - Free Tier)
# IMPORTANT: Upstash provides a rediss:// TLS connection string
REDIS_URL=rediss://default:your_upstash_password@your_endpoint.upstash.io:6379

# Cryptography & Security Secrets (Minimum 32 characters for JWT, 64-char hex for AES)
JWT_ACCESS_SECRET=vetralink_jwt_access_secret_minimum_32_characters_long_key
JWT_REFRESH_SECRET=vetralink_jwt_refresh_secret_minimum_32_characters_long_key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
AES_PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HASH_PEPPER=phone_hash_pepper_key_16_chars

# Database Connection Tuning
SLOW_QUERY_THRESHOLD_MS=200
DB_CONNECT_RETRY_DELAY_MS=1000

# Storage & Digital Fulfillment (Optional for basic API checking; defaults to mock)
AWS_REGION=us-east-1
S3_BUCKET_MEDIA=vetralink-media-dev
S3_BUCKET_DELIVERIES=vetralink-deliveries-dev
EMAIL_PROVIDER=mock
EMAIL_FROM=VetraLink Pro <orders@vetralink.pro>

# Optional Webhook & DRM Secrets
MFS_WEBHOOK_SECRET=mfs_webhook_secret_key_32_chars_long
HLS_DRM_KEY_SECRET=hls_drm_key_master_secret_32_chars_long
DRM_TOKEN_EXPIRATION_SECONDS=600
CLOUDFRONT_URL_EXPIRATION_SECONDS=3600

# Must be your trusted website origin. Host the role notification worker persistently;
# the Vercel HTTP handler does not run durable notification jobs.
WEB_BASE_URL=https://veterinary-pro-web.vercel.app
# Backend mail links append /api/v1 themselves; keep this value without a prefix.
API_BASE_URL=https://veterinary-api-mocha.vercel.app
# AUTH_LEGACY_CLAIMS_UNTIL=<absolute UTC deadline within the prior access TTL>
