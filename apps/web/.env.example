# Server-only Nest API root, including its global prefix. Copy to .env.local for local web development.
# Never use NEXT_PUBLIC_ for credentials/tokens. Override explicitly to use a local API.
API_BASE_URL=https://veterinary-api-mocha.vercel.app/api/v1
# API_BASE_URL=http://localhost:3001/api/v1
# Server terminal metadata logs: development defaults on; production requires 1.
# Set 0 to disable. Passwords, tokens, bodies and query values are excluded.
API_DEBUG=1
